# Configuration du serveur
PORT=3001
NODE_ENV=development

# Connexion MongoDB (obligatoire)
# retryWrites=false : nécessaire pour un MongoDB standalone (sans replica set)
MONGODB_URI=mongodb://localhost:27017/bibliotheque?retryWrites=false

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Secret de signature des tokens JWT (obligatoire en production)
JWT_SECRET=changez-moi-par-une-chaine-aleatoire-longue
JWT_EXPIRES_IN=7d

# --- Envoi des codes de réinitialisation de mot de passe ---
# SMTP renseigné  -> le code part par e-mail
# SMTP vide       -> le code s'affiche dans la console du backend (mode local)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=votre@gmail.com,
#         SMTP_PASS= <mot de passe d'application>, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bibliotheque <no-reply@localhost>